---
// A section divider drawn from a chaotic time series (see src/lib/signals.ts).
import { signals } from '../lib/signals';

interface Props {
  name: keyof typeof signals;
}
const s = signals[Astro.props.name];
---

<div class="signal" aria-hidden="true">
  <svg viewBox="0 0 1000 36" preserveAspectRatio="none" focusable="false">
    <path d={s.d} class:list={[s.stems && 'is-stems']}></path>
  </svg>
  <span class="signal__label">{s.label}</span>
</div>

<style>
  .signal {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.35rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  svg {
    width: 100%;
    height: 30px;
    overflow: visible;
  }

  path {
    fill: none;
    /* half accent blue, half the strong line grey: clearly visible, still quieter than text */
    stroke: color-mix(in srgb, var(--accent) 55%, var(--line-strong));
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }

  .signal__label {
    justify-self: end;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
</style>
